rules_version = '2';

// Storage security rules for Matcha Console.
// All app uploads are performed by signed-in users of the internal app.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // 商品画像
    match /products/{allPaths=**} {
      allow read, write: if signedIn();
    }
    // 仕入先の添付
    match /suppliers/{allPaths=**} {
      allow read, write: if signedIn();
    }
    // 発注（仕入）の請求書PDF
    match /purchase-orders/{allPaths=**} {
      allow read, write: if signedIn();
    }
    // 受領した仕入請求書PDF（消し込み用）
    match /purchase-invoices/{allPaths=**} {
      allow read, write: if signedIn();
    }
    // 発行した帳票PDF（請求書・納品書・見積書）
    match /sale-documents/{allPaths=**} {
      allow read, write: if signedIn();
    }
    // 発送伝票（送り状など）
    match /shipping-slips/{allPaths=**} {
      allow read, write: if signedIn();
    }
    // Resource Center（会員限定のレシピ・農園素材）。
    // ここは console のスタッフがアップロードするためのルール。会員への配信は
    // sabo-wholesale が Admin SDK で発行する署名付きURL経由で行うため、
    // これらのルール（＝クライアントSDK向け）の影響を受けない。
    // 素材の原本は getDownloadURL を使わない運用なので公開トークンURLは存在しない。
    match /resources/{allPaths=**} {
      allow read, write: if signedIn();
    }
  }
}
