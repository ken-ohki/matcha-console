NEXT_PUBLIC_FIREBASE_API_KEY=<SECRET_REMOVED>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<SECRET_REMOVED>
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<SECRET_REMOVED>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<SECRET_REMOVED>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<SECRET_REMOVED>
NEXT_PUBLIC_FIREBASE_APP_ID=<SECRET_REMOVED>
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=chaflow

# Catalog (public product list)
# Shared passcode shown to clients to unlock /catalog
CATALOG_PASSCODE=change-me
# Firebase service account JSON (single-line, escape inner quotes). Used server-side only.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
